---
// src/pages/publications.astro
import Layout from '../layouts/Layout.astro';
import fs from 'node:fs';
import bibtexParse from 'bibtex-parse-js';

const bibFilePath = `${process.cwd()}/src/data/publications.bib`;
const bibFile = fs.readFileSync(bibFilePath, 'utf8');
const parsedBib = bibtexParse.toJSON(bibFile);

// 【关键修改1】在这里保留 bib 的 entryType (文献类型)
const publications = parsedBib
  .map((item: any) => ({
    entryType: item.entryType.toLowerCase(), // 提取类型，如 'article', 'patent'
    ...item.entryTags
  }))
  .sort((a: any, b: any) => parseInt(b.year) - parseInt(a.year));

const groupedPubs = publications.reduce((acc: any, pub: any) => {
  const year = pub.year || 'Unknown';
  if (!acc[year]) acc[year] = [];
  acc[year].push(pub);
  return acc;
}, {});

const years = Object.keys(groupedPubs).sort((a, b) => parseInt(b) - parseInt(a));
---

<Layout title="学术论文与专利">
  <div class="mb-12">
    <h1 class="text-3xl md:text-4xl font-bold mb-4 text-slate-900 dark:text-white">成果展示 (Publications & Patents)</h1>
    <p class="text-lg text-slate-600 dark:text-slate-400">
      以下是我在 GIS、空间分析及相关领域的学术研究成果与发明专利。
    </p>
  </div>

  <div class="space-y-16">
    {years.map(year => (
      <section>
        <h2 class="text-2xl font-bold mb-6 border-b-2 border-slate-200 dark:border-slate-700 pb-2 text-blue-600 dark:text-blue-400 flex items-center gap-2">
          🗓️ {year}
        </h2>
        
        <ul class="space-y-8 pl-2 md:pl-4">
          {groupedPubs[year].map((pub: any) => (
            <li class="relative pl-6 border-l-2 border-slate-200 dark:border-slate-700 hover:border-blue-500 transition-colors">
              <div class="absolute -left-[9px] top-2 w-4 h-4 rounded-full bg-slate-200 dark:bg-slate-700 border-2 border-white dark:border-slate-900"></div>
              
              <div class="flex flex-col sm:flex-row sm:items-start gap-2 mb-2">
                {pub.entryType === 'patent' || pub.entryType === 'misc' ? (
                  <span class="inline-block px-2 py-1 text-xs font-bold bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400 rounded border border-emerald-200 dark:border-emerald-800 whitespace-nowrap mt-1">
                    📜 发明专利
                  </span>
                ) : (
                  <span class="inline-block px-2 py-1 text-xs font-bold bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-400 rounded border border-blue-200 dark:border-blue-800 whitespace-nowrap mt-1">
                    📄 学术论文
                  </span>
                )}
                
                <h3 class="text-xl font-bold text-slate-900 dark:text-slate-100 leading-tight">
                  {pub.title.replace(/[{}]/g, '')}
                </h3>
              </div>
              
              <p class="text-slate-700 dark:text-slate-300 mb-1">
                <span set:html={pub.author.replace(/Wu, Tao/g, '<strong>Wu, Tao</strong>').replace(/and/g, '&')} />
              </p>
              
              <p class="text-slate-500 dark:text-slate-400 italic mb-3 text-sm">
                {pub.entryType === 'patent' || pub.entryType === 'misc' ? (
                  <>授权编号: {pub.nationality} {pub.number}</>
                ) : (
                  <>
                    {pub.journal || pub.booktitle}
                    {pub.volume && `, Vol. ${pub.volume}`}
                    {pub.number && `, No. ${pub.number}`}
                    {pub.pages && `, pp. ${pub.pages.replace('--', '-')}`}
                  </>
                )}
              </p>

              <div class="flex gap-3">
                {(pub.url || pub.doi) && (
                  <a 
                    href={pub.url || `https://doi.org/${pub.doi}`} 
                    target="_blank"
                    class="text-sm px-3 py-1 bg-slate-100 hover:bg-blue-50 text-slate-700 hover:text-blue-600 dark:bg-slate-800 dark:hover:bg-blue-900/30 dark:text-slate-300 dark:hover:text-blue-400 rounded-md transition-colors font-medium border border-slate-200 dark:border-slate-700"
                  >
                    🔗 {pub.doi ? 'DOI' : '查看链接 (Link)'}
                  </a>
                )}
              </div>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Layout>