---
// src/layouts/Layout.astro
import '../styles/global.css';
const { title } = Astro.props;
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Tao Wu 学术主页</title>
  </head>
  
  <body class="bg-slate-50 text-slate-900 dark:bg-slate-900 dark:text-slate-100 transition-colors duration-300 min-h-screen flex flex-col">
    
    <div class="max-w-4xl w-full mx-auto px-4 sm:px-6 flex flex-col flex-grow">
      
      <header class="py-8 flex items-center justify-between">
        <a href="/" class="text-2xl font-bold tracking-tight text-blue-600 dark:text-blue-400">
          吴涛 TAO WU
        </a>
        
        <nav class="hidden sm:flex space-x-8 font-medium">
          <a href="/" class="hover:text-blue-600 dark:hover:text-blue-400 transition">首页 (Home)</a>
          <a href="/publications" class="hover:text-blue-600 dark:hover:text-blue-400 transition">科研成果 (Publications)</a>
          <a href="/courseworks" class="hover:text-blue-600 dark:hover:text-blue-400 transition">课程作业 (Courseworks)</a>
        </nav>

        <button class="sm:hidden block p-2 text-slate-600 dark:text-slate-300">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </header>

      <main class="flex-grow py-8">
        <slot />
      </main>

      <footer class="py-8 border-t border-slate-200 dark:border-slate-800 text-center text-sm text-slate-500 mt-auto">
        <p>&copy; {new Date().getFullYear()} Tao Wu. 构建基于 Astro 与 Tailwind CSS.</p>
      </footer>
      
    </div>
  </body>
</html>